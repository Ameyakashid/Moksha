; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MOKSHA — Five Ascents"
config/description="Five modular levels: city prologue and four floors. Optional sight trade, physical combat and cargo, branching objectives, persistent builds and an explicit campaign resolution. Duration target unvalidated."
run/main_scene="res://campaign/campaign.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

NoiseBus="*res://scripts/sensory/noise_bus.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

